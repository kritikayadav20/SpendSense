# Python environments and generated bytecode
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class

# Test, lint, type-check and coverage caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.tox/
.nox/
.cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
*.cover
.ipynb_checkpoints/

# Packaging and build outputs; keep dependency requirements/lock files
/build/
/dist/
*.egg-info/
.eggs/
*.egg

# Local secrets and credentials; keep the shareable Streamlit theme
.env
.env.*
!.env.example
!.env.sample
.streamlit/secrets.toml
.streamlit/credentials.toml
.aws/
.kaggle/
kaggle.json
credentials.json
service-account*.json
*.pem
*.key
*.p12
*.pfx

# Local SQLite databases, including journals and WAL/SHM sidecars
*.sqlite
*.sqlite3
*.db
*.sqlite-*
*.sqlite3-*
*.db-*
*.sqlite.bak
*.sqlite3.bak
*.db.bak

# Local datasets, imports, exports and active source configuration.
# Only the documented synthetic demo source and setup files are shareable.
/data/*
!/data/README.md
!/data/dataset.example.json
!/data/synthetic.json
!/data/raw/
!/data/processed/
/data/raw/*
!/data/raw/.gitkeep
!/data/raw/spendsense_synthetic_v1_seed42.csv
/data/processed/*
!/data/processed/.gitkeep

# Fitted models and active run pointers are recreated by src.train.
# The active synthetic demo run is committed so Streamlit Cloud can serve predictions.
/models/*
!/models/.gitkeep
!/models/active.json
!/models/20261015T115707Z-049bd6f5/
!/models/20261015T115707Z-049bd6f5/**
*.joblib
!/models/20261015T115707Z-049bd6f5/*.joblib
*.pkl
*.pickle

# Generated benchmark reports, figures and local verification output.
# Keep the active demo evaluation artifacts for the ML Lab page in cloud deploys.
/reports/metrics/*
!/reports/metrics/.gitkeep
!/reports/metrics/20261015T115707Z-049bd6f5/
!/reports/metrics/20261015T115707Z-049bd6f5/**
/reports/figures/*
!/reports/figures/.gitkeep
!/reports/figures/20261015T115707Z-049bd6f5/
!/reports/figures/20261015T115707Z-049bd6f5/**
/reports/verification/*
!/reports/verification/.gitkeep
/reports/results.md
/reports/submission.md

# Local transaction exports outside data/
/exports/
/backups/
/spendsense-expenses*.csv

# Runtime logs and temporary output
*.log
*.tmp
*.temp
/tmp/
/temp/

# Machine-specific editor and assistant state
.vscode/
.idea/
.codex/
.agents/
*.swp
*.swo
*~

